# Copy to .env next to docker-compose.yml.

# Served under a sub path (matches `location /botc/` in nginx). Empty for its own (sub)domain.
BASE_PATH=/botc
# Full public address, used in the join QR code.
PUBLIC_URL=https://boardpass.maisonbaron.nl/botc
# Port on 127.0.0.1 that nginx proxies to.
BOTC_PORT=3003

# ---- Boardpass sign-in ----
# Keep this line to sign in with Boardpass; remove it to run without accounts.
COMPOSE_FILE=docker-compose.yml:docker-compose.boardpass.yml
BOARDPASS_PUBLIC_URL=https://boardpass.maisonbaron.nl
# Shown once when you add the game in Boardpass:
#   docker compose exec boardpass node server/cli.js add-game botc "Blood on the Clocktower" https://boardpass.maisonbaron.nl/botc/
# and set its events URL to http://botc:3000/botc/boardpass/events
BOARDPASS_SECRET=

# ROOM_TTL_HOURS=48
# MAX_ROOMS=1000
