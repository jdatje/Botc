# Copy to .env next to docker-compose.yml.

# Empty: served at the root of its own subdomain (deploy/nginx/botc-site.conf).
# /botc: under a sub path of another site (deploy/nginx/botc-location.conf).
BASE_PATH=
# Full public address, used in the join QR code.
PUBLIC_URL=https://botc.maisonbaron.nl
# Port on 127.0.0.1 that nginx proxies to.
BOTC_PORT=3004

# ---- Boardpass sign-in ----
# Keep this line to sign in with Boardpass; remove it to run without accounts.
COMPOSE_FILE=docker-compose.yml:docker-compose.boardpass.yml
BOARDPASS_PUBLIC_URL=https://boardpass.maisonbaron.nl
# Shown once when you add the game in Boardpass:
#   docker compose exec boardpass node server/cli.js add-game botc "Blood on the Clocktower" https://botc.maisonbaron.nl/
# and set its events URL to http://botc:3000/boardpass/events
BOARDPASS_SECRET=

# ROOM_TTL_HOURS=48
# MAX_ROOMS=1000
